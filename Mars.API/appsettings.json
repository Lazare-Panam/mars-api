{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "ApplicationInsights",
        "Args": {
          "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "MongoDbSettings": {
    "DatabaseName": "MarsDB"
  },
  "JwtSettings": {
    "Issuer": "Mars.API",
    "Audience": "Mars.Client",
    "ExpireMinutes": 60
  },
  "EmailSettings": {
    "SenderAddress": "DoNotReply@marsvalveuk.com",
    "InternalAddressEmail": "sales@marsvalvenok.com",
    "AdminPortalUrl": "https://marsvalveuk.com/admin",
    "CatalogueUrl": "https://pblol2.blob.core.windows.net/mars-valves/catalogs/mars-e-catalog.pdf",
    "StockListUrl": "https://pblol2.blob.core.windows.net/mars-valves/Mars-StockList.pdf"
  },
  "ServiceBusSettings": {
    "EnquiryQueueName": "marsenquiries"
  },
  "TurnstileSettings": {
    "VerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
  },
  "MeilisearchSettings": {
    "Host": "https://ms-d06c17ba1b4c-49415.lon.meilisearch.io",
    "ApiKey": "c068629bf8169b1a6c39f56ac0a715faaef543b8a5786e3d94f7789f2dfb440e"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  }
}

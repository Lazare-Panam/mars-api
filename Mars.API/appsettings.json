{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "ApplicationInsights",
        "Args": {
          "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "MongoDbSettings": {
    "DatabaseName": "MarsDB"
  },
  "JwtSettings": {
    "Issuer": "Mars.API",
    "Audience": "Mars.Client",
    "ExpireMinutes": 60
  },
  "EmailSettings": {
    "SenderAddress": "DoNotReply@marsvalveuk.com",
    "InternalAddressEmail": "sales@marsvalvenok.com"
  },
  "ServiceBusSettings": {
    "EnquiryQueueName": "marsenquiries"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  }
}
